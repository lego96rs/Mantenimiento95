{{ define "content" }}
<section class="hero card">
	<p class="eyebrow">Panel privado</p>
	<h2>Bienvenido, {{ .UserName }}</h2>
	<p>
		La autenticacion local, las sesiones server-side, el CSRF y el cambio forzado de
		contraseña temporal ya están activos como base de la fase de seguridad.
	</p>
	<form method="post" action="/logout" class="inline-form">
		<input type="hidden" name="csrf" value="{{ .CSRF }}">
		<button type="submit" class="btn-secondary">Cerrar sesión</button>
	</form>
</section>

<section class="grid">
	<article class="card">
		<h3>Seguridad activa</h3>
		<ul>
			<li>Hash de contraseñas con Argon2id.</li>
			<li>Sesiones persistidas en SQLite.</li>
			<li>CSRF y headers de seguridad en rutas autenticadas.</li>
		</ul>
	</article>

	<article class="card">
		<h3>Siguientes módulos</h3>
		<ul>
			<li>Maestro de activos y documentos.</li>
			<li>Plantillas de mantenimiento.</li>
			<li>Programación y publicaciones operativas.</li>
		</ul>
	</article>
</section>
{{ end }}
