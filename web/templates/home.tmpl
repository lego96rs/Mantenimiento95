{{ define "content" }}
<section class="hero card">
	<p class="eyebrow">Panel privado</p>
	<h2>Bienvenido, {{ .UserName }}</h2>
	<p>
		La autenticacion local, las sesiones server-side, el CSRF y el cambio forzado de
		contraseña temporal ya están activos como base de la fase de seguridad.
	</p>
	<form method="post" action="/logout" class="inline-form">
		<input type="hidden" name="csrf" value="{{ .CSRF }}">
		<button type="submit" class="btn-secondary">Cerrar sesión</button>
	</form>
</section>

<section class="grid">
	<article class="card">
		<h3>Base segura</h3>
		<ul>
			<li>Hash de contraseñas con Argon2id.</li>
			<li>Sesiones persistidas en SQLite.</li>
			<li>CSRF y headers de seguridad en rutas autenticadas.</li>
		</ul>
	</article>

	<article class="card">
		<h3>Activos y catálogos</h3>
		<ul>
			<li><a href="/assets">Ver maestro de activos</a></li>
			{{ if or (eq .RoleLabel "admin") (eq .RoleLabel "planner") }}
			<li><a href="/catalogs">Gestionar áreas, categorías y documentos</a></li>
			<li><a href="/templates">Mantener plantillas de mantenimiento</a></li>
			<li><a href="/planning">Programar agenda y publicaciones</a></li>
			<li><a href="/execution">Operar órdenes de trabajo e incidentes</a></li>
			{{ else }}
			<li>Los catálogos se administran por usuarios `admin` o `planner`.</li>
			<li>Puedes consultar la <a href="/planning">agenda programada</a>.</li>
			<li>Puedes trabajar tu <a href="/execution">bandeja operativa</a> si tienes órdenes asignadas.</li>
			{{ end }}
			<li>La ejecución operativa ya permite asignación, checklist, progreso e incidentes.</li>
		</ul>
	</article>
</section>
{{ end }}
