{{ define "content" }}
<section class="page-card card narrow">
	<p class="eyebrow">Seguridad</p>
	<h2>Cambiar contraseña</h2>
	{{ if .User.MustChangePassword }}
	<p class="notice-warn" role="status">
		Tu contraseña es temporal. Debes cambiarla para continuar.
	</p>
	{{ end }}
	{{ if .Error }}<p class="form-error" role="alert">{{ .Error }}</p>{{ end }}

	<form method="post" action="/password" class="form-stack">
		<input type="hidden" name="csrf" value="{{ .CSRF }}">
		<input type="text" name="username" value="{{ .User.Username }}" autocomplete="username" readonly hidden>

		<label for="current">Contraseña actual</label>
		<input id="current" name="current" type="password" required autocomplete="current-password">

		<label for="new">Contraseña nueva</label>
		<input id="new" name="new" type="password" required minlength="8" autocomplete="new-password">

		<label for="confirm">Repite la contraseña nueva</label>
		<input id="confirm" name="confirm" type="password" required minlength="8" autocomplete="new-password">

		<button type="submit" class="btn-primary">Guardar</button>
	</form>
</section>
{{ end }}
